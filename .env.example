# Node.js 24.5+; model credentials are saved by `npm run login` in .pi/auth.json.
HOST=127.0.0.1
PORT=3000
PI_PROVIDER=openai
PI_MODEL=gpt-6.1-sol
# Set a secret gateway token before binding HOST=0.0.0.0 behind HTTPS.
# AI_GATEWAY_TOKEN=
# APP_ORIGIN=https://your-accounting-site.example
# PI_AGENT_DIR=/absolute/private/path/to/pi-auth
